{
  "schemaVersion": 1,
  "id": "flo.kbd-backlight",
  "name": "Keyboard backlight",
  "version": "1.0.0",
  "author": "flo",
  "license": "MIT",
  "description": "Ambient-light-driven keyboard backlight with a bar widget for tuning the curve.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Keyboard backlight",
    "description": "Auto-dims the keyboard backlight from the ambient light sensor.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "auto": true,
      "manualPercent": 40,
      "maxPercent": 100,
      "minPercent": 0,
      "luxDark": 5,
      "luxBright": 150,
      "pollIntervalMs": 2000,
      "smoothing": 0.65,
      "showPercent": false
    },
    "schema": [
      { "key": "auto", "type": "boolean", "label": "Follow the ambient light sensor", "defaultValue": true },
      { "key": "manualPercent", "type": "integer", "label": "Manual brightness (%)", "min": 0, "max": 100, "step": 1, "defaultValue": 40 },
      { "key": "maxPercent", "type": "integer", "label": "Brightness in the dark (%)", "min": 0, "max": 100, "step": 1, "defaultValue": 100 },
      { "key": "minPercent", "type": "integer", "label": "Brightness in bright light (%)", "min": 0, "max": 100, "step": 1, "defaultValue": 0 },
      { "key": "luxDark", "type": "integer", "label": "Dark below (raw sensor units)", "min": 0, "max": 2000, "step": 1, "defaultValue": 5 },
      { "key": "luxBright", "type": "integer", "label": "Bright above (raw sensor units)", "min": 1, "max": 20000, "step": 1, "defaultValue": 150 },
      { "key": "pollIntervalMs", "type": "integer", "label": "Sensor poll interval (ms)", "min": 500, "max": 30000, "step": 100, "defaultValue": 2000 },
      { "key": "smoothing", "type": "number", "label": "Smoothing (0 = instant, 0.9 = slow)", "min": 0, "max": 0.9, "step": 0.05, "defaultValue": 0.65 },
      { "key": "showPercent", "type": "boolean", "label": "Show the percentage in the bar", "defaultValue": false }
    ]
  }
}
